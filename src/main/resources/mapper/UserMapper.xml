<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nchu.learningplatform.mapper.UserMapper">
    <resultMap id="UserResultMap" type="com.nchu.learningplatform.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="role" property="role"/>
        <result column="gender" property="gender"/>
        <result column="learning_preference" property="learningPreference"/>
        <result column="course_interest" property="courseInterest"/>
        <result column="learning_goal" property="learningGoal"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!--  插入用户  -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, phone, email, avatar_url, role, gender, learning_preference, course_interest, learning_goal, status)
        VALUES (#{username}, #{password}, #{phone}, #{email}, #{avatarUrl}, #{role}, #{gender}, #{learningPreference}, #{courseInterest}, #{learningGoal}, #{status})
    </insert>

    <!--  根据用户名查询  -->
    <select id="findByUsername" resultMap="UserResultMap">
        SELECT * FROM user WHERE username = #{username}
    </select>

    <!--  根据手机号查询  -->
    <select id="findByPhone" resultMap="UserResultMap">
        SELECT * FROM user WHERE phone = #{phone}
    </select>

    <!--  根据邮箱查询  -->
    <select id="findByEmail" resultMap="UserResultMap">
        SELECT * FROM user WHERE email = #{email}
    </select>

    <!--  根据用户名或手机号查询  -->
    <select id="findByUsernameOrPhone" resultMap="UserResultMap">
        SELECT * FROM user WHERE username = #{usernameOrPhone} OR phone = #{usernameOrPhone}
    </select>

    <!--  根据ID查询  -->
    <select id="findById" resultMap="UserResultMap">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <!--  更新用户信息（除手机号外）  -->
    <update id="updateUserInfo">
        UPDATE user
        <set>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="avatarUrl != null and avatarUrl != ''">avatar_url = #{avatarUrl},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="learningPreference != null and learningPreference != ''">learning_preference = #{learningPreference},</if>
            <if test="courseInterest != null and courseInterest != ''">course_interest = #{courseInterest},</if>
            <if test="learningGoal != null and learningGoal != ''">learning_goal = #{learningGoal},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!--  更新密码  -->
    <update id="updatePassword">
        UPDATE user SET password = #{newPassword} WHERE id = #{userId}
    </update>

    <!--  管理员功能：分页查询用户列表  -->
    <select id="pageQueryUser" resultMap="UserResultMap">
        SELECT
            id,
            username,
            phone,
            email,
            avatar_url,
            role,
            gender,
            learning_preference,
            course_interest,
            learning_goal,
            status,
            create_time
        FROM user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    username LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                    OR email LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!--  管理员功能：统计用户总数  -->
    <select id="countUser" resultType="long">
        SELECT COUNT(*)
        FROM user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    username LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                    OR email LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </select>

    <!--  管理员功能：删除用户  -->
    <delete id="deleteById">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!--  管理员功能：更新用户状态  -->
    <update id="updateStatus">
        UPDATE user SET status = #{status} WHERE id = #{id}
    </update>

    <!--  获取当前最大用户ID  -->
    <select id="getMaxId" resultType="java.lang.Long">
        SELECT IFNULL(MAX(id), 0) FROM user
    </select>

    <!--  重置AUTO_INCREMENT，使其等于指定值  -->
    <update id="resetAutoIncrement">
        ALTER TABLE user AUTO_INCREMENT = #{nextId}
    </update>

    <!--  按月统计注册用户数  -->
    <select id="countUsersByMonth" resultType="java.util.Map">
        SELECT DATE_FORMAT(create_time, '%Y-%m') AS month, COUNT(*) AS count
        FROM user
        GROUP BY month
        ORDER BY month
    </select>
</mapper>
